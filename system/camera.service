[Unit]
Description=Camera
After=mediamtx.service

[Service]
WorkingDirectory=/opt/mncam
ExecStart=/usr/bin/python3 -m c2
# pipewire/wireplumber probe the camera through their libcamera plugin and
# hold the CFE front-end nodes (/dev/media0, /dev/video7) while they do it.
# Starting into that race gets "Failed to start streaming: Broken pipe" from
# the front-end and the service stays dead until someone starts it by hand,
# which on a headless camera means no source at all. Retrying clears it.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
